# LifeOS configuration. Copy to .env and fill in what you need.

# Server
LIFEOS_LISTEN_ADDR=127.0.0.1:8787
LIFEOS_DATA_DIR=./data
LIFEOS_TIMEZONE=Europe/Moscow
LIFEOS_LOG_LEVEL=info

# LLM (OpenAI-compatible). Leave the key empty to run without the assistant.
LIFEOS_LLM_PROVIDER=openrouter
LIFEOS_LLM_BASE_URL=https://openrouter.ai/api/v1
LIFEOS_LLM_API_KEY=
LIFEOS_LLM_MODEL=recursive/flint-v1.0:free
# Resilience: retries per model, backoff base, and extra fallback models.
LIFEOS_LLM_RETRY_ATTEMPTS=3
LIFEOS_LLM_RETRY_DELAY_MS=400
LIFEOS_LLM_FALLBACK_MODELS=
# Tool rounds per assistant turn. Bulk imports (40+ events) need headroom.
LIFEOS_ASSISTANT_MAX_ROUNDS=12

# Document extraction. Falls back to the assistant LLM settings when omitted.
# Use a free model on OpenRouter: particle-ai/particle-1:free supports images.
LIFEOS_DOC_LLM_BASE_URL=https://openrouter.ai/api/v1
LIFEOS_DOC_LLM_API_KEY=
LIFEOS_DOC_LLM_MODEL=particle-ai/particle-1:free
LIFEOS_DOCUMENTS_DIR=./data/documents

# Local Ollama example:
# LIFEOS_LLM_PROVIDER=ollama
# LIFEOS_LLM_BASE_URL=http://127.0.0.1:11434/v1
# LIFEOS_LLM_API_KEY=
# LIFEOS_LLM_MODEL=llama3.1

# MCP (tools-only, read-only unless writes are explicitly enabled)
LIFEOS_MCP_ENABLED=false
LIFEOS_MCP_PATH=/mcp
LIFEOS_MCP_ALLOW_WRITES=false

# Local machine tools (files and shell). An empty root gives the assistant access
# to the whole machine; set a directory to keep it inside one tree.
LIFEOS_TOOLS_ROOT=
LIFEOS_TOOLS_SHELL=true
