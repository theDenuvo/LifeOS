# LifeOS configuration. Copy to .env and fill in what you need.

# Server
LIFEOS_LISTEN_ADDR=127.0.0.1:8787
LIFEOS_DATA_DIR=./data
LIFEOS_TIMEZONE=Europe/Moscow
LIFEOS_LOG_LEVEL=info

# LLM (OpenAI-compatible). Leave the key empty to run without the assistant.
LIFEOS_LLM_PROVIDER=openrouter
LIFEOS_LLM_BASE_URL=https://openrouter.ai/api/v1
LIFEOS_LLM_API_KEY=
LIFEOS_LLM_MODEL=openai/gpt-4o-mini

# Local Ollama example:
# LIFEOS_LLM_PROVIDER=ollama
# LIFEOS_LLM_BASE_URL=http://127.0.0.1:11434/v1
# LIFEOS_LLM_API_KEY=
# LIFEOS_LLM_MODEL=llama3.1

# MCP (tools-only, read-only unless writes are explicitly enabled)
LIFEOS_MCP_ENABLED=false
LIFEOS_MCP_PATH=/mcp
LIFEOS_MCP_ALLOW_WRITES=false
